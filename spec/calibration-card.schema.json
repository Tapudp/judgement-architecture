{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:judgment-architecture:spec:calibration-card:0.1",
  "title": "Calibration Card",
  "description": "How honest a decision model's confidence is, for one question pack × model version × language. Judgment Architecture v0.1 (draft).",
  "type": "object",
  "required": ["spec_version", "card_id", "issued_at", "subject", "evaluation", "reliability", "summary"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": "0.1" },
    "card_id": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "issuer": { "type": "string", "description": "Who measured it. Independent issuers should say so." },
    "subject": {
      "type": "object",
      "required": ["question_id", "question_version", "model_id", "language"],
      "additionalProperties": false,
      "properties": {
        "pack": { "type": "string" },
        "question_id": { "type": "string" },
        "question_version": { "type": "string" },
        "model_id": { "type": "string", "description": "Pinned version, never an alias." },
        "language": { "type": "string", "description": "BCP 47 tag, e.g. en, es-MX, ar-SA, hi-Latn" },
        "consequence_class": { "enum": ["C0", "C1", "C2", "C3"] }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["n", "label_source"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1, "description": "Number of labelled judgments evaluated." },
        "label_source": { "type": "string", "description": "Where ground truth came from, e.g. 'human review band, Aug 2026', 'public benchmark X'." },
        "period": { "type": "string" },
        "data_uri": { "type": "string" }
      }
    },
    "reliability": {
      "type": "array",
      "minItems": 1,
      "description": "Confidence bands with claimed vs measured accuracy.",
      "items": {
        "type": "object",
        "required": ["low", "high", "claimed", "measured", "share"],
        "additionalProperties": false,
        "properties": {
          "low": { "type": "number", "minimum": 0, "maximum": 1 },
          "high": { "type": "number", "minimum": 0, "maximum": 1 },
          "claimed": { "type": "number", "minimum": 0, "maximum": 1, "description": "Mean reported confidence in the band." },
          "measured": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share actually correct." },
          "share": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of judgments in the band." },
          "n": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["ece", "accuracy"],
      "additionalProperties": false,
      "properties": {
        "ece": { "type": "number", "minimum": 0, "maximum": 1, "description": "Expected calibration error." },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "coverage_at": {
          "type": "object",
          "description": "Share of judgments acted on automatically at a given threshold, with the measured accuracy of those judgments.",
          "additionalProperties": {
            "type": "object",
            "required": ["coverage", "accuracy"],
            "additionalProperties": false,
            "properties": {
              "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
              "accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "recommended_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold_basis": { "type": "string" }
      }
    },
    "economics": {
      "type": "object",
      "description": "Optional Judgment Economics inputs and results.",
      "additionalProperties": false,
      "properties": {
        "review_cost_usd": { "type": "number", "minimum": 0 },
        "error_cost_usd": { "type": "number", "minimum": 0 },
        "monthly_volume": { "type": "number", "minimum": 0 },
        "calibration_interest_usd_per_month": { "type": "number", "minimum": 0 }
      }
    },
    "robustness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "injection_tested": { "type": "boolean" },
        "max_confidence_shift": { "type": "number", "minimum": 0, "maximum": 1, "description": "Largest change in confidence observed under adversarial state." },
        "notes": { "type": "string" }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_card_id": { "type": "string" },
        "ece_delta": { "type": "number" },
        "accuracy_delta": { "type": "number" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
